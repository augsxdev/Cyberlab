<Window x:Class="CyberLab.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CyberLab" Width="1000" Height="680" Background="#0B1120">
  <Grid Margin="36">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="CYBERLAB" FontSize="28" FontWeight="Bold" Foreground="#67E8F9"/><TextBlock Text="Visibilidade defensiva para sua rede autorizada" Foreground="#94A3B8" Margin="0,6,0,24"/></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="#111C31" CornerRadius="12" Margin="0,0,16,0" Padding="22"><StackPanel><TextBlock Text="Dispositivos online" Foreground="#94A3B8"/><TextBlock Text="—" x:Name="DevicesText" FontSize="42" Foreground="White" Margin="0,8"/></StackPanel></Border>
      <Border Grid.Column="1" Background="#111C31" CornerRadius="12" Margin="0,0,16,0" Padding="22"><StackPanel><TextBlock Text="Alertas críticos" Foreground="#94A3B8"/><TextBlock Text="—" x:Name="AlertsText" FontSize="42" Foreground="#FB7185" Margin="0,8"/></StackPanel></Border>
      <Border Grid.Column="2" Background="#111C31" CornerRadius="12" Padding="22"><StackPanel><TextBlock Text="API local" Foreground="#94A3B8"/><TextBlock Text="Aguardando" x:Name="StatusText" FontSize="20" Foreground="#FCD34D" Margin="0,16"/></StackPanel></Border>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,28,0,0"><TextBox x:Name="TargetInput" Width="280" Height="42" Padding="12" Text="192.168.1.10"/><Button Content="Iniciar Scan" Click="StartScan_Click" Width="160" Height="42" Margin="12,0,0,0" Background="#0891B2" Foreground="White" BorderThickness="0"/><TextBlock x:Name="ResultText" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="18,0,0,0"/></StackPanel>
  </Grid>
</Window>
